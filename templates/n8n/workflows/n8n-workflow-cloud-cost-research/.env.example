# =========================================================
# n8n Cloud Cost Research — Variables de entorno
# NUNCA commitear valores reales
# =========================================================

# --- REQUERIDAS ---

# API Key del LLM (Anthropic, OpenAI-compatible)
LLM_API_KEY=sk-ant-PLACEHOLDER-DO-NOT-USE

# Slack Incoming Webhook URL para alertas
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/PLACEHOLDER/PLACEHOLDER/PLACEHOLDER

# --- OPCIONALES ---

# Modo de datos: 'aws' o 'csv_fixture' (default: csv_fixture)
COST_DATA_MODE=csv_fixture

# Threshold de alerta en USD (default: 2000)
COST_ALERT_THRESHOLD=2000

# --- SOLO PARA MODO aws ---

# AWS credentials con IAM policy de solo lectura (ce:GetCostAndUsage)
AWS_ACCESS_KEY_ID=AKIA-PLACEHOLDER-DO-NOT-USE
AWS_SECRET_ACCESS_KEY=PLACEHOLDER-DO-NOT-USE

# --- OPCIONALES DE LLM ---

LLM_MODEL=claude-sonnet-4-6
LLM_API_URL=https://api.anthropic.com/v1/messages

# URL alternativa del CSV de costos (default: fixture del repo)
CSV_FIXTURE_URL=https://raw.githubusercontent.com/ClickITMx/clickit-agentic-low-code-templates/main/templates/n8n/workflows/n8n-workflow-cloud-cost-research/src/fixtures/costs-dummy.csv
