# GitHub Personal Access Token (classic)
# Scopes necesarios: repo (o pull_requests + contents + issues)
GITHUB_TOKEN=ghp_PLACEHOLDER-DO-NOT-USE

# API Key del LLM
LLM_API_KEY=sk-ant-PLACEHOLDER-DO-NOT-USE

# Modelo LLM (default: claude-sonnet-4-6)
LLM_MODEL=claude-sonnet-4-6

# URL de la API LLM (default: Anthropic)
LLM_API_URL=https://api.anthropic.com/v1/messages
