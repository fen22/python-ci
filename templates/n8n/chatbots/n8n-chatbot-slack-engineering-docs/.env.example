# =========================================================
# n8n Slack Engineering Docs Bot — Variables de entorno
# Copiar como .env y completar los valores reales
# NUNCA commitear este archivo con valores reales
# =========================================================

# --- REQUERIDAS ---

# Token del Bot de Slack (formato: xoxb-...)
# Obtener en: api.slack.com/apps → OAuth & Permissions → Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-PLACEHOLDER-DO-NOT-USE

# API Key del LLM (Anthropic, OpenAI, etc.)
LLM_API_KEY=sk-ant-PLACEHOLDER-DO-NOT-USE

# URL de la fuente de documentación (debe responder a GET con texto o JSON)
# Ejemplos:
#   GitHub raw:   https://raw.githubusercontent.com/org/repo/main/docs/README.md
#   Notion page:  https://api.notion.com/v1/blocks/<page-id>/children
#   URL pública:  https://docs.ejemplo.com/api/content
DOCS_SOURCE_URL=https://PLACEHOLDER-DOCS-URL

# --- OPCIONALES ---

# Modelo LLM a usar (default: claude-3-5-sonnet-20241022)
# Anthropic: claude-3-5-sonnet-20241022, claude-3-opus-20240229
# OpenAI:    gpt-4o, gpt-4-turbo
LLM_MODEL=claude-3-5-sonnet-20241022

# URL base de la API del LLM (default: Anthropic)
# Anthropic: https://api.anthropic.com/v1/messages
# OpenAI:    https://api.openai.com/v1/chat/completions
LLM_API_URL=https://api.anthropic.com/v1/messages
