# Claude MCP Infra Assistant — Variables de entorno
# Estas variables van en mcp.json, NO en variables de entorno del sistema
# Ver src/mcp-config.example.json para contexto

# GitHub Fine-grained token (scopes: read-only para repos seleccionados)
GITHUB_PERSONAL_ACCESS_TOKEN=github_pat_PLACEHOLDER-DO-NOT-USE

# AWS (IAM user con solo lectura — ver src/security-guardrails.md para la IAM policy)
AWS_ACCESS_KEY_ID=AKIA-PLACEHOLDER-DO-NOT-USE
AWS_SECRET_ACCESS_KEY=PLACEHOLDER-DO-NOT-USE
AWS_REGION=us-east-1

# Brave Search API (gratis en brave.com/search/api/)
BRAVE_API_KEY=PLACEHOLDER-DO-NOT-USE
