# Langflow RAG Docs Chatbot — Variables de entorno
# Estos valores se configuran en el UI de Langflow, no en variables de entorno directamente
# Este archivo es referencia de qué keys necesitas obtener

# Anthropic API Key para Claude LLM
LLM_API_KEY=sk-ant-PLACEHOLDER-DO-NOT-USE

# OpenAI API Key para embeddings (text-embedding-3-small)
# Si usas AnthropicEmbeddings, no necesitas esto
OPENAI_API_KEY=sk-PLACEHOLDER-DO-NOT-USE
