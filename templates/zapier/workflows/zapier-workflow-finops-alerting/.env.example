# Zapier FinOps Alerting — Variables de referencia
# Estas variables NO van en n8n ni en .env — se configuran directamente en cada Step del Zap.
# Este archivo es solo documentación de referencia.

# URL de tu API o Lambda que devuelve los costos cloud (Step 3 del blueprint)
AWS_COST_API_URL=https://tu-api-gateway.amazonaws.com/prod/costs

# Threshold de alerta en USD (configurar en Step 4, campo inputData.threshold)
COST_THRESHOLD_USD=2000

# Canal de Slack destino (configurar en Step 6)
SLACK_CHANNEL=#finops-alerts

# Email destino para reporte opcional (configurar en Step 7)
FINOPS_EMAIL=finops@tuempresa.com
